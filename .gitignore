build/
dist/
*.spec

# ─── Test files (don't commit sample payloads or stego images) ─
*.stego.png
test_carrier.png
test_stego.png
recovered.*
secret.*

# ─── VS Code ──────────────────────────────────────────────────
.vscode/*
