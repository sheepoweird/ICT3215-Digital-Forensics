# Only the codebase goes to GitHub. Everything at the top level is ignored unless it is listed below
# images, local tools) stay local by default. To publish a new top-level code
# folder or file, add a "!/name" line here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/build.bat
!/Python/
!/ESP32 Files/
!/packaging/
!/md/

# ─── Private runtime files (never commit) ─────────────────────
# Pairing credential, app settings and lock files written next to the app.
Python/token_config.json
Python/envstego_settings.ini
Python/.token-ble.lock
.vault.lock

# ─── Generated output ─────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.python-version
*.egg-info/
*.log
build/
dist/
*.spec
!/packaging/EnvStego.spec
# Firmware bundled by build.bat for the in-app flasher (built, not source)
Python/firmware/
# PlatformIO build output and per-user editor settings
.pio/
.vscode/

# ─── Non-code files that may land in code folders ─────────────
# Documents, and carriers/payloads left behind by manual testing.
*.doc
*.docx
*.pdf
*.odt
*.pptx
*.rtf
Python/**/*.png
Python/**/*.jp*g
Python/**/*.webp
Python/**/*.bmp
Python/**/*.tif*
Python/**/*.gif
Python/**/*.wav
Python/**/*.mp3
Python/**/*.flac
Python/**/*.ogg
Python/**/*.zip

# ─── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
