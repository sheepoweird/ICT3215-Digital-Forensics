.DS_Store
Thumbs.db
desktop.ini

# ─── pip / eggs ───────────────────────────────────────────────
*.egg-info/
.eggs/
pip-log.txt
.pytest_cache/

# ─── Logs ─────────────────────────────────────────────────────
*.log

DF Main Doc.docx
Project Assignment.html
Python/token_config.json

# ─── Local dev / verification tools (not part of the app) ─────
# Screenshot renderer + live token security checker. They drive or
# verify the app but are not needed to run it; kept local, not shipped.
/devtools/
/Images/
# ─── Evidence (local only — report artifacts, not app code) ───
# Logs + screenshots documenting test/verification runs. Kept locally
# for the report; not pushed. The app and tests do not depend on them.
/evidence/
